{
  "name": "laboratorio-arquivos-texto",
  "version": "0.1.0",
  "private": true,
  "description": "Objeto de Aprendizagem Interativo sobre Formatos de Arquivos de Texto na Programação (CSV, Posicional/CNAB, JSON e XML)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\" \"index.html\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\" \"index.html\""
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.6"
  }
}

